{
  // Configuração explícita de publicação na Cloudflare.
  //
  // Sem este arquivo, o Workers Builds tenta adivinhar o projeto e exige o
  // plugin oficial de Vite, que por sua vez exige Vite 6+. Declarando aqui,
  // não há adivinhação: é um Worker só de arquivos estáticos, servindo a
  // pasta dist que o Vite gera.
  "name": "aylla-imports",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Qualquer caminho desconhecido devolve o index.html: o aplicativo é uma
    // página só, e a navegação acontece dentro dela.
    "not_found_handling": "single-page-application"
  }
}
